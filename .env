# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=1227673e001e8dca46ef4aa4273af4f2
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://localhost
###< symfony/routing ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://liboke:!ChangeMe!@database:5432/liboke?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> docker ###
# Variables lues par docker compose (substitution dans compose*.yaml).
# Surcharger dans .env.local, jamais ici.
SERVER_NAME=localhost
POSTGRES_DB=liboke
POSTGRES_USER=liboke
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_VERSION=16
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
# Xdebug désactivé par défaut : XDEBUG_MODE=debug make up pour l'activer
XDEBUG_MODE=off
###< docker ###

###> stripe/stripe-php ###
# Clés de TEST uniquement ici. JAMAIS de clé live dans un fichier versionné :
# les vraies valeurs vont dans .env.local (développement) ou dans
# l'environnement du serveur (production).
#
# Les valeurs ci-dessous sont des marqueurs : elles laissent l'application
# démarrer, tout appel réel à Stripe échouera avec un message explicite.
STRIPE_SECRET_KEY=sk_test_remplacer_par_une_cle_de_test
STRIPE_WEBHOOK_SECRET=whsec_remplacer_par_le_secret_de_la_cli
# Utilisée par le conteneur stripe-cli du compose de développement.
STRIPE_API_KEY=
###< stripe/stripe-php ###

###> seo ###
# Hôte canonique : toutes les URLs absolues (canonical, Open Graph, sitemap)
# et les redirections 301 en découlent. En production : l'hôte réel, le choix
# www / sans-www restant à arrêter (CLAUDE.md §7).
CANONICAL_URL=https://localhost
# 1 uniquement sur le site public de production. Pilote robots.txt,
# l'en-tête X-Robots-Tag et la balise meta robots.
SITE_INDEXABLE=0
###< seo ###

###> admin ###
# Unique compte de l'espace /admin (CLAUDE.md §10). Tant que l'une de ces
# deux valeurs est vide, personne ne peut se connecter.
# Le hash se génère avec « make admin-password » et se place, entre
# apostrophes simples (il contient des « $ »), dans .env.local en
# développement ou dans l'environnement du serveur en production.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# https partout, sauf dans les tests dont le client émet en http.
ADMIN_REQUIRED_SCHEME=https
###< admin ###

###> contact ###
# Adresse qui reçoit les messages du formulaire de contact, et adresse
# d'expédition. En développement, Mailpit intercepte tout.
CONTACT_TO=contact@association-liboke.com
MAILER_FROM=site@association-liboke.com
###< contact ###
