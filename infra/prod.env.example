# Modèle de /var/www/liboke/.env.prod.local — secrets de PRODUCTION.
#
#   cp infra/prod.env.example .env.prod.local && chmod 600 .env.prod.local
#
# Ce fichier réel n'est JAMAIS versionné (.gitignore : /.env.*.local) ni copié
# dans l'image Docker (.dockerignore). Il est lu par bin/prod, à la fois pour
# l'interpolation de compose.prod.yaml et comme variables des conteneurs.
#
# Syntaxe : une valeur contenant « $ » (hash bcrypt) se met entre apostrophes
# SIMPLES, sinon Docker Compose tente de l'interpréter.

###> docker ###
# Port local publié pour le Caddy de l'hôte. Doit être libre : vérifier avec
#   ss -ltn | grep ':8090 '
LIBOKE_HTTP_PORT=8090
###< docker ###

###> symfony ###
# openssl rand -hex 32
APP_SECRET=
###< symfony ###

###> base de données ###
# Base propre à liboke, dans son conteneur, non exposée.
# Mot de passe : openssl rand -base64 24 | tr -d '/+='
POSTGRES_DB=liboke
POSTGRES_USER=liboke
POSTGRES_PASSWORD=
###< base de données ###

###> site ###
# Hôte canonique (sans slash final) : canoniques, sitemap, redirections 301.
CANONICAL_URL=https://association-liboke.org
# 0 tant que le contenu est provisoire ([À COMPLÉTER]) : robots.txt en
# « Disallow: / » et en-tête noindex. Passer à 1 à l'ouverture réelle.
SITE_INDEXABLE=0
###< site ###

###> e-mails ###
# Prestataire SMTP à choisir. En attendant, « null://null » : aucun envoi, mais
# les messages de contact restent consultables dans /admin.
MAILER_DSN=null://null
CONTACT_TO=contact@association-liboke.org
MAILER_FROM=site@association-liboke.org
###< e-mails ###

###> stripe ###
# Clés de TEST tant que le compte Stripe de l'association n'est pas branché.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de l'endpoint déclaré dans le tableau de bord Stripe
# (Développeurs → Webhooks → https://<domaine>/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
###< stripe ###

###> admin ###
# Hash (après le premier build) :
#   docker run --rm -it --entrypoint php liboke-php-prod bin/console security:hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
###< admin ###
