{% extends 'base.html.twig' %}

{% block body %}
    <article class="page">
        {% include 'components/_fil_ariane.html.twig' %}

        <h1>{{ page.title }}</h1>

        <div class="page__contenu">
            {{ page.html|raw }}
        </div>

        {#
          Deux étapes sur la même page, pilotées par le contrôleur Stimulus
          « don » : choix du montant, puis formulaire de paiement Stripe
          intégré (Embedded Checkout). Stripe.js n'est chargé qu'à la seconde
          étape, quand le donateur a choisi de payer.

          `secret_client` n'est présent que si le formulaire a été envoyé sans
          passer par le contrôleur : le paiement s'ouvre alors au chargement.
        #}
        <div class="don"
             data-controller="don"
             data-don-cle-publique-value="{{ cle_publique }}"
             {% if secret_client %}data-don-secret-value="{{ secret_client }}"{% endif %}>

            <div data-don-target="formulaire"{{ secret_client ? ' hidden' }}>
                {% include 'donation/_formulaire.html.twig' %}
            </div>

            <section class="paiement" data-don-target="paiement" aria-labelledby="paiement-titre" tabindex="-1"{{ secret_client ? '' : ' hidden' }}>
                <h2 id="paiement-titre">Paiement de votre don</h2>

                <p class="paiement__etat" data-don-target="etat" role="status">
                    Chargement du formulaire de paiement sécurisé…
                </p>

                <div class="paiement__widget" data-don-target="widget"></div>

                <p>
                    <button type="button" class="lien-bouton" data-action="don#modifier">
                        ‹ Modifier le montant
                    </button>
                </p>
            </section>

            <noscript>
                <p class="alerte alerte--erreur">
                    Le paiement en ligne nécessite JavaScript. Merci de l'activer
                    dans votre navigateur, ou de nous contacter pour faire un don
                    par un autre moyen.
                </p>
            </noscript>
        </div>
    </article>
{% endblock %}
