{# Icônes des cartes « Nos engagements », décoratives (le titre suffit). #}
<svg class="engagement__icone" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if icone == 'education' %}
        <path d="M2 7l10-4 10 4-10 4z"/>
        <path d="M6 9v5c0 1.7 2.7 3 6 3s6-1.3 6-3V9"/>
        <path d="M22 7v6"/>
    {% elseif icone == 'environnement' %}
        <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/>
        <path d="M5 19l8-8"/>
    {% else %}
        <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
        <path d="M12 9v5M9.5 11.5h5"/>
    {% endif %}
</svg>
