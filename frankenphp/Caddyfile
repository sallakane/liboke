{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		format filter {
			wrap console
			fields {
				uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	root /app/public
	encode zstd br gzip

	# Assets AssetMapper : le nom de fichier porte une empreinte du contenu,
	# ils peuvent donc être mis en cache indéfiniment (CLAUDE.md §8).
	# Uniquement sur les réponses 2xx : une 404 ne doit jamais être figée.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable" {
		match status 2xx
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
